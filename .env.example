# ════════════════════════════════════════════════════════════════════
#  SnortVision v0.1 — Environment Configuration
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your values below
#  3. Run:             docker compose up -d --build
# ════════════════════════════════════════════════════════════════════

# ── Ports ─────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=4000

# ── Snort Sensor (SSH connection + alert source) ───────────────────────
# IP address of the machine running Snort3
# Leave EMPTY to use local tail mode (when backend runs on same box as Snort)
SNORT_HOST=
SNORT_SSH_PORT=22
SNORT_SSH_USER=snort
SNORT_AUTH_MODE=SSH Key
# Path to the alert_json log file ON the Snort machine (or local path if SNORT_HOST is empty)
SNORT_LOG_PATH=/var/log/snort/alert_json.txt

# ── Router Management Target (optional) ───────────────────────────────
# This does NOT replace the Snort sensor. It is used to query router
# management details such as firmware, WAN/LAN IPs, interfaces and firewall context.
ROUTER_HOST=
ROUTER_SSH_PORT=22
ROUTER_SSH_USER=root
ROUTER_AUTH_MODE=Password
ROUTER_TYPE=OpenWRT
ROUTER_MONITOR_IFACE=
ROUTER_MIRROR_TARGET=

# ── PulledPork / Oinkcode ────────────────────────────────────────────
# Path to pulledpork config (for rule updates via Oinkcode)
# PULLEDPORK_CONF=/etc/snort/pulledpork.conf
# Command to reload Snort after rule updates (optional)
# SNORT_RELOAD_CMD=systemctl reload snort3

# ── Backend API Key (optional) ────────────────────────────────────────
# If set, the frontend must send X-API-Key header. Leave blank = no auth.
API_KEY=

# ── GeoIP Country/City lookup ─────────────────────────────────────────
# Set to true to show country flags and city on attack map
# After setting true, rebuild: docker compose up -d --build
GEOIP_ENABLE=true

# ── Telegram Alerts ───────────────────────────────────────────────────
# Get bot token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=high

# ── Email Alerts ──────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_SMTP=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
EMAIL_MIN_SEVERITY=critical

# ── Slack Alerts ──────────────────────────────────────────────────────
SLACK_ENABLED=false
SLACK_WEBHOOK=
SLACK_MIN_SEVERITY=high
# Dedicated Snort sensor interface. If left blank, SnortVision will fall back to main-router interface counters when available.
SENSOR_INTERFACE=
DDOS_PACKET_PPS_THRESHOLD=8000
DDOS_ALERT_RATE_THRESHOLD=20
